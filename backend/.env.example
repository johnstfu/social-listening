# Radar Backend — Variables d'environnement
# Copier en .env et remplir les valeurs

# ── Base de données ──────────────────────────────────────────
# PostgreSQL (Railway fournit cette URL automatiquement)
DATABASE_URL=postgresql://user:password@localhost:5432/radar_dev

# ── Sécurité ─────────────────────────────────────────────────
# Générer avec : python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGE_MOI_ABSOLUMENT

# ── CORS ─────────────────────────────────────────────────────
# URLs du frontend (séparées par des virgules)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://radar.seriousagency.com

# ── Google OAuth (login + GMB) ────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# ── Google Business Profile OAuth ────────────────────────────
GBP_CLIENT_ID=your_gbp_client_id
GBP_CLIENT_SECRET=your_gbp_client_secret
GBP_REDIRECT_URI=http://localhost:3000/auth/gbp/callback

# ── Google Places API ─────────────────────────────────────────
GOOGLE_PLACES_API_KEY=your_google_places_api_key

# ── Facebook OAuth (optionnel) ────────────────────────────────
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret

# ── Email (récap hebdo) ───────────────────────────────────────
SENDGRID_API_KEY=your_sendgrid_api_key
FROM_EMAIL=radar@seriousagency.com

# ── Claude AI (analyse sentiment) ────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key
